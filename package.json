{
  "name": "@pmochine/vue-axios-interceptors",
  "version": "2.0.0",
  "description": "Catch and handle axios responses globally, for example in a Vue 3 app",
  "type": "commonjs",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./vue": {
      "import": {
        "types": "./dist/vue.d.mts",
        "default": "./dist/vue.mjs"
      },
      "require": {
        "types": "./dist/vue.d.ts",
        "default": "./dist/vue.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "vue"
  ],
  "scripts": {
    "build": "vite build",
    "lint": "eslint .",
    "test": "vitest run && npm run test:types",
    "test:types": "tsc -p tests/types",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pmochine/vue-axios-interceptors.git"
  },
  "keywords": [
    "vue",
    "vue 3",
    "vue3",
    "axios",
    "interceptors",
    "event bus",
    "laravel",
    "validation errors",
    "ajax errors",
    "error handling",
    "typescript"
  ],
  "author": "Philipp Mochine",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/pmochine/vue-axios-interceptors/issues"
  },
  "homepage": "https://github.com/pmochine/vue-axios-interceptors#readme",
  "peerDependencies": {
    "axios": "^1.0.0",
    "vue": "^2.7.0 || ^3.2.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "axios": "^1.20.0",
    "eslint": "^10.12.0",
    "eslint-config-avidofood": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "vue": "^3.5.43"
  }
}
